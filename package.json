{
	"name": "@turystack/fields",
	"description": "Zod schemas for entity fields — request bodies and forms.",
	"private": false,
	"version": "0.0.3",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./br": {
			"types": "./dist/br.d.ts",
			"import": "./dist/br.js",
			"default": "./dist/br.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=20"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:cov": "vitest run --coverage",
		"lint": "biome lint ./src",
		"format": "biome format --write ./src",
		"check": "biome check ./src",
		"check:fix": "biome check --write ./src",
		"prepack": "pnpm run build"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/turystack/fields.git"
	},
	"peerDependencies": {
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@vitest/coverage-v8": "^4.1.10",
		"reflect-metadata": "^0.2.2",
		"tsc-alias": "^1.9.1",
		"typescript": "^7.0.2",
		"vite": "^8.1.5",
		"vitest": "^4.1.10",
		"zod": "^4.4.3"
	}
}
